{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskTwins",
  "mainBinaryName": "disktwins",
  "version": "0.1.0",
  "identifier": "io.github.milaleo.disktwins",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiskTwins — modified version of GEMINUS by lucixdev",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "milaleo",
    "copyright": "Copyright (C) 2026 lucix.dev <lucix.dev@proton.me> (GEMINUS); modifications Copyright (C) 2026 milaleo",
    "licenseFile": "../LICENSE",
    "shortDescription": "Compare two disks or folders (modified version of GEMINUS by lucixdev)",
    "longDescription": "DiskTwins is a modified version of GEMINUS by lucixdev, not the original program. It compares two disks or two folders and shows side by side what is identical, what changed and what exists on one side only. Differences can then be copied, moved or deleted by dragging them between the two columns. It reads file contents when asked to, keeps working on slow or damaged disks, and can check the physical health of the drives before comparing them.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../LICENSE-EXCEPTION.txt": "LICENSE-EXCEPTION.txt",
      "../LICENSE-ADDITIONAL-TERMS.txt": "LICENSE-ADDITIONAL-TERMS.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/disktwins/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/disktwins/LICENSE": "../LICENSE"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
